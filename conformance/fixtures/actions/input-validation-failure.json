{
  "id": "actions/input-validation-failure",
  "title": "Input that fails the declared schema returns -32004 before the handler runs",
  "spec": "/protocol/actions/",
  "requires": [],
  "fixture": {
    "actions": [
      {
        "name": "add",
        "inputSchema": {
          "type": "object",
          "properties": {
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            }
          },
          "required": ["a", "b"]
        },
        "returns": {
          "sum": 3
        },
        "assertHandlerNotCalled": true
      }
    ]
  },
  "steps": [
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "~capture:helloId",
        "method": "tesseron/hello",
        "params": {
          "protocolVersion": "~regex:^1\\.[0-9]+\\.[0-9]+$",
          "app": {
            "id": "~regex:^[a-z][a-z0-9_]*$",
            "name": "~string",
            "origin": "~string"
          },
          "actions": "~array",
          "resources": "~array",
          "capabilities": {
            "streaming": "~boolean",
            "subscriptions": "~boolean",
            "sampling": "~boolean",
            "elicitation": "~boolean"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:helloId",
        "result": {
          "sessionId": "s_conformance_0001",
          "protocolVersion": "1.2.0",
          "capabilities": {
            "streaming": true,
            "subscriptions": true,
            "sampling": true,
            "elicitation": true
          },
          "agent": {
            "id": "agent_conformance",
            "name": "conformance-runner"
          },
          "claimCode": "AB3X-7K",
          "resumeToken": "rt_conformance_0001"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "inv-1",
        "method": "actions/invoke",
        "params": {
          "name": "add",
          "input": {
            "a": "not-a-number"
          },
          "invocationId": "i-1"
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "inv-1",
        "error": {
          "code": -32004,
          "message": "~string",
          "data": "~any"
        }
      }
    }
  ]
}
