{
  "id": "actions/invoke-success",
  "title": "A valid invoke runs the handler and returns its output verbatim",
  "spec": "/protocol/actions/",
  "requires": [],
  "fixture": {
    "actions": [
      {
        "name": "add",
        "returns": {
          "sum": 3
        }
      }
    ]
  },
  "steps": [
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "~capture:helloId",
        "method": "tesseron/hello",
        "params": {
          "protocolVersion": "~regex:^1\\.[0-9]+\\.[0-9]+$",
          "app": {
            "id": "~regex:^[a-z][a-z0-9_]*$",
            "name": "~string",
            "origin": "~string"
          },
          "actions": "~array",
          "resources": "~array",
          "capabilities": {
            "streaming": "~boolean",
            "subscriptions": "~boolean",
            "sampling": "~boolean",
            "elicitation": "~boolean"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:helloId",
        "result": {
          "sessionId": "s_conformance_0001",
          "protocolVersion": "1.2.0",
          "capabilities": {
            "streaming": true,
            "subscriptions": true,
            "sampling": true,
            "elicitation": true
          },
          "agent": {
            "id": "agent_conformance",
            "name": "conformance-runner"
          },
          "claimCode": "AB3X-7K",
          "resumeToken": "rt_conformance_0001"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "inv-1",
        "method": "actions/invoke",
        "params": {
          "name": "add",
          "input": {
            "a": 1,
            "b": 2
          },
          "invocationId": "i-1"
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "inv-1",
        "result": {
          "invocationId": "i-1",
          "output": {
            "sum": 3
          }
        }
      }
    }
  ]
}
