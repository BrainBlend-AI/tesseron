{
  "id": "elicitation/confirm-decline-is-false",
  "title": "ctx.confirm collapses a declined elicit to false rather than throwing",
  "spec": "/protocol/elicitation/",
  "requires": ["elicitation"],
  "fixture": {
    "actions": [
      {
        "name": "deleteAll",
        "confirms": "Delete everything?",
        "returnsConfirmResult": true
      }
    ]
  },
  "steps": [
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "~capture:helloId",
        "method": "tesseron/hello",
        "params": {
          "protocolVersion": "~regex:^1\\.[0-9]+\\.[0-9]+$",
          "app": {
            "id": "~regex:^[a-z][a-z0-9_]*$",
            "name": "~string",
            "origin": "~string"
          },
          "actions": "~array",
          "resources": "~array",
          "capabilities": {
            "streaming": "~boolean",
            "subscriptions": "~boolean",
            "sampling": "~boolean",
            "elicitation": "~boolean"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:helloId",
        "result": {
          "sessionId": "s_conformance_0001",
          "protocolVersion": "1.2.0",
          "capabilities": {
            "streaming": true,
            "subscriptions": true,
            "sampling": true,
            "elicitation": true
          },
          "agent": {
            "id": "agent_conformance",
            "name": "conformance-runner"
          },
          "claimCode": "AB3X-7K",
          "resumeToken": "rt_conformance_0001"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "inv-1",
        "method": "actions/invoke",
        "params": {
          "name": "deleteAll",
          "input": {},
          "invocationId": "i-1"
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "~capture:elicitId",
        "method": "elicitation/request",
        "params": {
          "invocationId": "i-1",
          "question": "Delete everything?",
          "schema": "~object"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:elicitId",
        "result": {
          "action": "decline"
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "inv-1",
        "result": {
          "invocationId": "i-1",
          "output": {
            "confirmed": false
          }
        }
      },
      "note": "Decline, cancel, and missing elicitation capability all collapse to false. None of them throw."
    }
  ]
}
